# API Sentinel Configuration Template

# Server Configuration
PROJECT_NAME="API Sentinel"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=sentinel_super_secret_jwt_key_change_in_production_32bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secure_pass
POSTGRES_DB=apisentinel
DATABASE_URL=postgresql://sentinel:sentinel_secure_pass@localhost:5432/apisentinel
# Local SQLite Fallback: sqlite:///./sentinel.db

# CORS Configuration (json list)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Security Testing Mode
AUTHORIZED_TESTING_ONLY=True
SCANNER_MAX_CONCURRENT_JOBS=5

# AI Security Analyst Configuration
AI_PROVIDER=mock # Options: mock, openai
OPENAI_API_KEY=
